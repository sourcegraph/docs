{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"fluid": true,
	"ignoreCommand": "sh dev/vercel-ignore-build.sh",
	"headers": [
		{
			"source": "/(.*)",
			"has": [
				{"type": "host", "value": "^\\d+\\.\\d+\\.sourcegraph\\.com$"}
			],
			"headers": [{"key": "X-Robots-Tag", "value": "noindex"}]
		}
	]
}
