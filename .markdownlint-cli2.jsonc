// List style for docs/. markdownlint-cli2 and editor markdownlint extensions
// read this file; dev/check-markdownlint.mjs checks it on PRs and explains how
// to run it locally
{
	"config": {
		"default": false,
		// Bullets are dashes
		"MD004": {"style": "dash"},
		// Nested bullets are indented 2 spaces, as Prettier writes them
		// (prettier.config.js)
		"MD007": {"indent": 2},
		// One space after a list marker, so a bullet's text starts 2 columns in
		// and a bullet nested 2 spaces is under it
		"MD030": true,
		// Ordered lists are numbered 1, 2, 3
		"MD029": {"style": "ordered"}
	},
	"globs": ["docs/**/*.{md,mdx}"],
	// Generated in sourcegraph/sourcegraph by the 🤖 Sync generated docs PRs;
	// fix those upstream
	"ignores": [
		"docs/admin/telemetry/**",
		"docs/ai/models.mdx",
		"docs/cli/references/**",
		"docs/cody/capabilities/supported-models.mdx",
		"docs/self-hosted/observability/alerts.mdx",
		"docs/self-hosted/observability/dashboards.mdx"
	]
}
